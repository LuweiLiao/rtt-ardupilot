        "windows_mi": "MI_00",
        "must_not_be_slcan": true
      },
      {
        "id": "slcan_cdc",
        "interface": "if02",
        "mission_planner_role": "SLCAN",
        "linux_by_id_pattern": "/dev/serial/by-id/usb-ArduPilot_*_CUAV*_*-if02",
        "windows_mi": "MI_02",
        "must_not_be_mission_planner_mavlink": true
      }
    ]
