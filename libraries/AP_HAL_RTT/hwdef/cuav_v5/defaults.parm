# ChibiOS-style second logical USB CDC port for CAN SLCAN passthrough.
SERIAL6_PROTOCOL 22
CAN_P1_DRIVER 1
CAN_D1_PROTOCOL 1
# The bench-tested CUAV V5 connector used for USB SLCAN maps to ArduPilot's
# second CAN interface on this RTT port. Keep CAN1 enabled, but route SLCAN to
# CAN2 so the second USB virtual port can observe/drive the connected bus.
CAN_P2_DRIVER 1
CAN_D2_PROTOCOL 1
CAN_SLCAN_CPORT 2
