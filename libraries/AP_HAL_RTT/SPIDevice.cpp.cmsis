 *
 * RTT port — CMSIS register direct-drive SPI, 1:1 following ChibiOS.
 *
 * Complete rewrite replacing old RT-Thread framework (rt_spi_device).
 * Reference design:
 *   AP_HAL_ChibiOS/SPIDevice.cpp  — HAL-layer API
 *   modules/ChibiOS/os/hal/ports/STM32/LLD/SPIv2/hal_spi_lld.c  — register LLD
 *
 * ChibiOS SPIDevice.cpp key patterns:
 *   259-281  derive_freq_flag_bus()   — dynamic BR
 *   285-295  set_speed()              — store target frequency
 *   319-340  acquire_bus()            — lock + spiStart
 *   340-388  do_transfer()            — polled exchange
 *   spi_lld.c:597-626                 — spi_lld_exchange() register loop
 *   spi_lld.c:260-280                 — spiStart() CR1 config
 */
#include <AP_HAL/AP_HAL.h>
#include <AP_Math/AP_Math.h>
#include "SPIDevice.h"
#include "Scheduler.h"
#include "DeviceBus.h"

extern const AP_HAL::HAL &hal;

/*
 * SPI bus clock sources (STM32F765 @ 216MHz):
 *   SPI1/SPI4/SPI5/SPI6: APB2 = 108MHz (HCLK/2)
 *   SPI2/SPI3:           APB1 = 54MHz  (HCLK/4)
 */
static const uint32_t spi_bus_clocks[RTT_SPI_MAX_BUSES] = {
    108000000U,  // SPI1  APB2
     54000000U,  // SPI2  APB1
     54000000U,  // SPI3  APB1
    108000000U,  // SPI4  APB2
    108000000U,  // SPI5  APB2
    108000000U,  // SPI6  APB2
};

/*
 * SPI peripheral base addresses indexed by bus number (1-based).
 */
static SPI_TypeDef * const spi_periphs[RTT_SPI_MAX_BUSES] = {
    SPI1,   // bus 0 = SPI1
    SPI2,   // bus 1 = SPI2
    SPI3,   // bus 2 = SPI3
    SPI4,   // bus 3 = SPI4
    SPI5,   // bus 4 = SPI5
    SPI6,   // bus 5 = SPI6
};

/*
 * Derive BR (baud rate divider) field value from target frequency.
 * Reference: ChibiOS SPIDevice.cpp:259-281 (derive_freq_flag_bus)
 *
 * BR field: divisor = 2^(BR+1), where:
 *   BR=0 → /2 = 54MHz, BR=1 → /4 = 27MHz, ..., BR=7 → /256 = 421.875kHz
 */
static uint32_t derive_br(uint32_t bus_clock_hz, uint32_t target_freq_hz)
{
    uint32_t br = 0;
    uint32_t freq = bus_clock_hz;
    while (freq > target_freq_hz && br < 7) {
        freq >>= 1;
        br++;
    }
    return br << SPI_CR1_BR_Pos;   // BR_0 = 0x20 (bit 3)
}

/* -------------------------------------------------------------------
 * GPIO helpers: CS pin control via BSRR register
 *   BSRR lower 16 bits = set pins, upper 16 bits = reset pins
 * ----------------------------------------------------------------- */

static inline void _gpio_set(volatile uint32_t *port, uint16_t pin_mask)
{
    port[6] = (uint32_t)pin_mask;              // BSRR low = set
}

static inline void _gpio_clear(volatile uint32_t *port, uint16_t pin_mask)
{
    port[6] = ((uint32_t)pin_mask) << 16;      // BSRR high = reset
}

static inline volatile uint32_t *_cs_port(uint32_t port_base)
{
    return (volatile uint32_t *)port_base;
}

/* -------------------------------------------------------------------
 * GPIO / Clock init (CUAV V5 specific)
 * SPI1: PG11(SCK) PA6(MISO) PD7(MOSI) — AF5
 * SPI4: PE2(SCK) PE13(MISO) PE6(MOSI) — AF5
 * ----------------------------------------------------------------- */

static bool _spi_gpio_inited[RTT_SPI_MAX_BUSES] = {false};

static void _spi1_gpio_init(void)
{
    if (_spi_gpio_inited[0]) return;

    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN | RCC_AHB1ENR_GPIODEN |
                    RCC_AHB1ENR_GPIOGEN;
    (void)RCC->AHB1ENR;

    // PG11 SCK: MODE=AF(10), AF=AF5
    GPIOG->MODER = (GPIOG->MODER & ~(3U << 22)) | (2U << 22);
    GPIOG->AFR[1] = (GPIOG->AFR[1] & ~(0xFU << 12)) | (5U << 12);
    // OSPEEDR = 50MHz (0b11)
    GPIOG->OSPEEDR |= (3U << 22);

    // PA6 MISO: MODE=AF(10), AF=AF5
    GPIOA->MODER = (GPIOA->MODER & ~(3U << 12)) | (2U << 12);
    GPIOA->AFR[0] = (GPIOA->AFR[0] & ~(0xFU << 24)) | (5U << 24);
    GPIOA->OSPEEDR |= (3U << 12);

    // PD7 MOSI: MODE=AF(10), AF=AF5
    GPIOD->MODER = (GPIOD->MODER & ~(3U << 14)) | (2U << 14);
    GPIOD->AFR[0] = (GPIOD->AFR[0] & ~(0xFU << 28)) | (5U << 28);
    GPIOD->OSPEEDR |= (3U << 14);

    RCC->APB2ENR |= RCC_APB2ENR_SPI1EN;
    (void)RCC->APB2ENR;

    _spi_gpio_inited[0] = true;
}

static void _spi4_gpio_init(void)
{
    if (_spi_gpio_inited[3]) return;

    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOEEN | RCC_AHB1ENR_GPIOFEN;
    (void)RCC->AHB1ENR;

    // PE2 SCK: MODE=AF(10), AF=AF5
    GPIOE->MODER = (GPIOE->MODER & ~(3U << 4)) | (2U << 4);
    GPIOE->AFR[0] = (GPIOE->AFR[0] & ~(0xFU << 8)) | (5U << 8);
    GPIOE->OSPEEDR |= (3U << 4);

    // PE13 MISO: MODE=AF(10), AF=AF5
    GPIOE->MODER = (GPIOE->MODER & ~(3U << 26)) | (2U << 26);
    GPIOE->AFR[1] = (GPIOE->AFR[1] & ~(0xFU << 20)) | (5U << 20);
    GPIOE->OSPEEDR |= (3U << 26);

    // PE6 MOSI: MODE=AF(10), AF=AF5
    GPIOE->MODER = (GPIOE->MODER & ~(3U << 12)) | (2U << 12);
    GPIOE->AFR[0] = (GPIOE->AFR[0] & ~(0xFU << 24)) | (5U << 24);
    GPIOE->OSPEEDR |= (3U << 12);

    RCC->APB2ENR |= RCC_APB2ENR_SPI4EN;
    (void)RCC->APB2ENR;

    _spi_gpio_inited[3] = true;
}

static void _spi_gpio_init(uint8_t bus_num)
{
    switch (bus_num) {
    case 0: _spi1_gpio_init(); break;
    case 3: _spi4_gpio_init(); break;
    default: break;
    }
}

namespace RTT
{

/*
 * Static CS pin lookup — indexed by device table entry index.
 * CUAV V5 topology (from hwdef):
 *   dev 0: ICM20689 → PF2  (BIT2)  [NEEDS HW UPDATE — actual CUAV V5 = ICM42688 PF11]
 *   dev 1: ICM20602 → PF3  (BIT3)  [NEEDS HW UPDATE — doesn't exist on CUAV V5]
 *   dev 2: BMI055_G → PF4  (BIT4)
 *   dev 3: BMI055_A → PG10 (BIT10)
 *   dev 4: ramtron  → PF5  (BIT5)
 *   dev 5: MS5611   → PF10 (BIT10)
 */
struct spi_cs_info {
    uint32_t port_base;     // GPIO port base address
    uint16_t pin_mask;      // Pin bit mask
};

static const spi_cs_info cs_table[HAL_SPI_DEVICE_COUNT] = {
    {GPIOF_BASE, (1U << 2)},   // dev 0: ICM20689 CS = PF2
    {GPIOF_BASE, (1U << 3)},   // dev 1: ICM20602 CS = PF3
    {GPIOF_BASE, (1U << 4)},   // dev 2: BMI055_G CS = PF4
    {GPIOG_BASE, (1U << 10)},  // dev 3: BMI055_A CS = PG10
    {GPIOF_BASE, (1U << 5)},   // dev 4: ramtron CS = PF5
    {GPIOF_BASE, (1U << 10)},  // dev 5: MS5611 CS = PF10
};

/* -------------------------------------------------------------------
 * SPIBus constructor + peripheral control
 * Reference: ChibiOS SPIDevice.cpp SPIBus::start_peripheral / stop_peripheral
 * ----------------------------------------------------------------- */

SPIBus::SPIBus(uint8_t _bus_num)
    : DeviceBus(APM_RTT_SPI_PRIORITY)
{
    // Initialize bus during construction
    bus_num = _bus_num;
    spi = spi_periphs[_bus_num];
    spi_started = false;
    low_speed = 0;
    high_speed = 0;
    current_br = 0;
}

void SPIBus::start_peripheral(void)
{
    if (spi_started) {
        return;
    }
    // ChibiOS spi_lld.c:260-280 (spiStart)
    // Enable CR1: MSTR | SPE | SSM | SSI | appropriate BR + mode bits
    uint32_t cr1 = SPI_CR1_MSTR | SPI_CR1_SSM | SPI_CR1_SSI | SPI_CR1_SPE | current_br;
    if (cfg.mode & 0x01) cr1 |= SPI_CR1_CPHA;
    if (cfg.mode & 0x02) cr1 |= SPI_CR1_CPOL;
    // ChibiOS: set FRXTH so RXNE fires on single-byte reception, not 16-bit
    spi->CR2 = SPI_CR2_FRXTH;
    spi->CR1 = cr1;
    __DSB();
    spi_started = true;
}

void SPIBus::stop_peripheral(void)
{
    if (!spi_started) {
        return;
    }
    spi->CR1 &= ~SPI_CR1_SPE;
    __DSB();
    spi_started = false;
}

/* -------------------------------------------------------------------
 * Static bus/device table (owned by SPIDeviceManager)
 * ----------------------------------------------------------------- */

SPIDesc SPIDeviceManager::device_table[] = { HAL_SPI_DEVICE_LIST };
SPIBus *SPIDeviceManager::_buses[RTT_SPI_MAX_BUSES] = {};

/* -------------------------------------------------------------------
 * SPIDevice constructor — finds/initializes the right SPIBus
 * ----------------------------------------------------------------- */

SPIDevice::SPIDevice(SPIDesc &desc)
    : _desc(desc)
    , _bus(nullptr)
    , _speed(0)
    , _br(0)
    , _cs_held(false)
    , _bus_locked(false)
{
    if (desc.bus < RTT_SPI_MAX_BUSES) {
        if (SPIDeviceManager::_buses[desc.bus] == nullptr) {
            SPIDeviceManager::_buses[desc.bus] = NEW_NOTHROW SPIBus(desc.bus);
        }
        _bus = SPIDeviceManager::_buses[desc.bus];
    }
    // Init GPIO once
    _spi_gpio_init(desc.bus);

    // Setup CS pin as output, HIGH (deselected)
    // Find CS info by matching device index in the device table
    const spi_cs_info *cs = nullptr;
    for (uint8_t i = 0; i < HAL_SPI_DEVICE_COUNT; i++) {
        if (strcmp(desc.name, SPIDeviceManager::device_table[i].name) == 0) {
            cs = &cs_table[i];
            break;
        }
    }

    if (cs != nullptr) {
        volatile uint32_t *port = _cs_port(cs->port_base);
        // Find pin number from mask
        uint8_t pin = 0;
        uint32_t m = cs->pin_mask;
        while (m != 0 && (m & 1) == 0) { pin++; m >>= 1; }
        // MODER = output (01)
        uint32_t moder_shift = pin * 2;
        *port = (*port & ~(3U << moder_shift)) | (1U << moder_shift);
        // OSPEEDR = 50MHz (11)
        *(port + 1) |= (3U << moder_shift);
        // Set HIGH
        _gpio_set(port, cs->pin_mask);
    }
}

SPIDevice::~SPIDevice()
{
    _unlock_bus();
}

/* -------------------------------------------------------------------
 * set_speed — store target frequency, compute BR
 * Reference: ChibiOS SPIDevice.cpp:285-295
 * ----------------------------------------------------------------- */

bool SPIDevice::set_speed(AP_HAL::Device::Speed speed)
{
    if (_bus == nullptr) {
        return false;
    }
    uint32_t target_hz;
    switch (speed) {
    case AP_HAL::Device::SPEED_LOW:
        target_hz = _desc.lowspeed;
        _speed = 1;
        break;
    case AP_HAL::Device::SPEED_HIGH:
        target_hz = _desc.highspeed;
        _speed = 2;
        break;
    default:
        return false;
    }
    uint32_t bus_clock = spi_bus_clocks[_desc.bus];
    _br = derive_br(bus_clock, target_hz);
    return true;
}

/* -------------------------------------------------------------------
 * Bus lock/unlock
 * ----------------------------------------------------------------- */

bool SPIDevice::_lock_bus()
{
    if (_bus == nullptr) {
        return false;
    }
    if (!_bus_locked) {
        _bus->semaphore.take_blocking();
        _bus_locked = true;
    }
    return true;
}

void SPIDevice::_unlock_bus()
{
    if (_bus != nullptr && _bus_locked) {
        _bus->semaphore.give();
        _bus_locked = false;
    }
}

/* -------------------------------------------------------------------
 * get_semaphore — return bus-level semaphore
 * Reference: ChibiOS SPIDevice.cpp:337-340
 * ----------------------------------------------------------------- */

AP_HAL::Semaphore *SPIDevice::get_semaphore()
{
    if (_bus == nullptr) {
        return nullptr;
    }
    return &_bus->semaphore;
}

/* -------------------------------------------------------------------
 * CS control — lookup pin info via static cs_table
 * ----------------------------------------------------------------- */

void SPIDevice::_cs_low(void)
{
    for (uint8_t i = 0; i < HAL_SPI_DEVICE_COUNT; i++) {
        if (strcmp(_desc.name, SPIDeviceManager::device_table[i].name) == 0) {
            volatile uint32_t *port = _cs_port(cs_table[i].port_base);
            _gpio_clear(port, cs_table[i].pin_mask);
            return;
        }
    }
}

void SPIDevice::_cs_high(void)
{
    for (uint8_t i = 0; i < HAL_SPI_DEVICE_COUNT; i++) {
        if (strcmp(_desc.name, SPIDeviceManager::device_table[i].name) == 0) {
            volatile uint32_t *port = _cs_port(cs_table[i].port_base);
            _gpio_set(port, cs_table[i].pin_mask);
            return;
        }
    }
}

bool SPIDevice::set_chip_select(bool set)
{
    // Reference: ChibiOS set_chip_select pattern
    if (set) {
        if (!_bus_locked && !_lock_bus()) {
            return false;
        }
        _acquire_bus();
        _cs_low();
    } else {
        _cs_high();
        _stop_peripheral();
    }
    _cs_held = set;
    return true;
}

/* -------------------------------------------------------------------
 * start/stop peripheral, acquire bus
 * ----------------------------------------------------------------- */

void SPIDevice::_acquire_bus(void)
{
    if (_bus == nullptr) {
        return;
    }
    // Set BR and mode before starting
    _bus->current_br = _br;
    _bus->cfg.mode = _desc.mode;
    _bus->start_peripheral();
}

void SPIDevice::_start_peripheral(void)
{
    _acquire_bus();
}

void SPIDevice::_stop_peripheral(void)
{
    if (_bus != nullptr) {
        _bus->stop_peripheral();
    }
}

/* -------------------------------------------------------------------
 * do_transfer — polled full-duplex register-level SPI transfer
 * Reference: ChibiOS spi_lld.c:597-626 (spi_lld_exchange)
 *
 * STM32F7 SPI flags (SR register):
 *   BSY  (bit 7) — Busy flag
 *   OVR  (bit 6) — Overrun flag
 *   MODF (bit 5) — Mode fault
 *   TXE  (bit 1) — TX buffer empty
 *   RXNE (bit 0) — RX buffer not empty
 * ----------------------------------------------------------------- */

bool SPIDevice::_do_transfer(const uint8_t *send, uint32_t send_len,
                              uint8_t *recv, uint32_t recv_len)
{
    if (_bus == nullptr) {
        return false;
    }
    SPI_TypeDef *spi = _bus->spi;

    // Clear overrun flag by reading SR then DR
    (void)spi->SR;
    (void)spi->DR;

    uint32_t remaining_send = send_len;
    uint32_t remaining_recv = recv_len;
    const uint8_t *tx = send;
    uint8_t *rx = recv;

    // The transfer length is the max of send and recv
    uint32_t total = MAX(send_len, recv_len);

    for (uint32_t i = 0; i < total; i++) {
        // Wait for TXE (transmit buffer empty)
        uint32_t timeout = 100000;
        while (!(spi->SR & SPI_SR_TXE)) {
            if (--timeout == 0) {
                return false;
            }
        }

        // Write data to DR (or dummy 0xFF if no send data)
        if (remaining_send > 0) {
            spi->DR = *tx++;
            remaining_send--;
        } else {
            spi->DR = 0xFF;
        }

        // Wait for RXNE (receive buffer not empty)
        timeout = 100000;
        while (!(spi->SR & SPI_SR_RXNE)) {
            if (--timeout == 0) {
                return false;
            }
        }

        // Read data from DR
        uint8_t data = (uint8_t)spi->DR;
        if (remaining_recv > 0) {
            *rx++ = data;
            remaining_recv--;
        }
    }

    // Wait for BSY to clear (last byte fully shifted out)
    uint32_t timeout = 100000;
    while (spi->SR & SPI_SR_BSY) {
        if (--timeout == 0) {
            return false;
        }
    }

    // Drain any extra byte (reads DR again to clear RXNE)
    (void)spi->DR;

    return true;
}

/* -------------------------------------------------------------------
 * transfer / transfer_fullduplex — public API
 * Reference: ChibiOS SPIDevice.cpp:340-388
 * ----------------------------------------------------------------- */

bool SPIDevice::transfer(const uint8_t *send, uint32_t send_len,
                          uint8_t *recv, uint32_t recv_len)
{
    if (!_lock_bus()) {
        return false;
    }

    _acquire_bus();
    _cs_low();

    bool ret = _do_transfer(send, send_len, recv, recv_len);

    _cs_high();
    _stop_peripheral();
    _unlock_bus();

    return ret;
}

bool SPIDevice::transfer_fullduplex(const uint8_t *send, uint8_t *recv, uint32_t len)
{
    return transfer(send, len, recv, len);
}

/* -------------------------------------------------------------------
 * register_periodic_callback, adjust_periodic_callback
 * Reference: ChibiOS register_periodic_callback pattern
 * ----------------------------------------------------------------- */

AP_HAL::Device::PeriodicHandle SPIDevice::register_periodic_callback(
    uint32_t period_usec, AP_HAL::Device::PeriodicCb cb)
{
    if (_bus == nullptr) {
        return nullptr;
    }
    return _bus->register_periodic_callback(period_usec, cb, nullptr);
}

bool SPIDevice::adjust_periodic_callback(
    AP_HAL::Device::PeriodicHandle h, uint32_t period_usec)
{
    if (_bus == nullptr) {
        return false;
    }
    return _bus->adjust_timer(h, period_usec);
}

/* -------------------------------------------------------------------
 * SPIDeviceManager implementation
 * ----------------------------------------------------------------- */

AP_HAL::SPIDevice *SPIDeviceManager::get_device_ptr(const char *name)
{
    for (uint8_t i = 0; i < ARRAY_SIZE(device_table); i++) {
        if (strcmp(name, device_table[i].name) == 0) {
            return NEW_NOTHROW SPIDevice(device_table[i]);
        }
    }
    return nullptr;
}

uint8_t SPIDeviceManager::get_count(void)
{
    return ARRAY_SIZE(device_table);
}

const char *SPIDeviceManager::get_device_name(uint8_t idx)
{
    if (idx >= ARRAY_SIZE(device_table)) {
        return nullptr;
    }
    return device_table[idx].name;
}

void SPIDeviceManager::set_register_rw_callback(const char* name, AP_HAL::Device::RegisterRWCb cb)
{
    // Stub — not yet implemented
}

